generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id           String        @id
  email        String        @unique
  name         String?
  imageUrl     String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  events       Event[]
  subscription Subscription?

  @@map("users")
}

model Subscription {
  id                    String            @id @default(cuid())
  userId                String            @unique
  user                  User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan                  SubscriptionPlan  @default(FREE)
  status                SubStatus         @default(ACTIVE)
  stripeCustomerId      String?
  stripeSubscriptionId  String?
  stripePriceId         String?
  currentPeriodStart    DateTime?
  currentPeriodEnd      DateTime?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  @@map("subscriptions")
}

enum SubscriptionPlan {
  FREE
  BASIC
  PREMIUM
}

enum SubStatus {
  ACTIVE
  CANCELLED
  PAST_DUE
  TRIALING
}

enum EventType {
  WEDDING
  BIRTHDAY
  CONFERENCE
  CONCERT
  CHURCH
  SEMINAR
  VIP_PARTY
  BURIAL
  PRIVATE_DINNER
  OTHER
}

model Event {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  name           String
  slug           String    @unique
  eventType      EventType @default(WEDDING)
  date           DateTime
  time           String?
  venue          String
  description    String?   @db.Text
  dressCode      String?
  rsvpDeadline   DateTime?

  organizerName  String?
  organizerPhone String?
  organizerEmail String?

  logoUrl        String?
  coverUrl       String?
  primaryColor   String    @default("#0A2810")
  secondaryColor String    @default("#B8860B")
  accentColor    String    @default("#F8F4E3")

  templateId     String?
  template       Template? @relation(fields: [templateId], references: [id])

  isPublished    Boolean   @default(false)
  requirePhoto   Boolean   @default(true)
  maxGuests      Int?

  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  guests         Guest[]
  checkins       Checkin[]

  @@index([userId])
  @@index([slug])
  @@map("events")
}

model Guest {
  id          String       @id @default(cuid())
  eventId     String
  event       Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)

  name        String
  phone       String
  email       String?

  invited     Boolean      @default(true)
  importedAt  DateTime     @default(now())
  importedVia ImportSource @default(MANUAL)

  rsvp        Rsvp?
  checkin     Checkin?

  @@unique([eventId, phone])
  @@index([eventId])
  @@index([phone])
  @@map("guests")
}

enum ImportSource {
  MANUAL
  BULK_TEXT
  CSV
  EXCEL
  TEXT
  DOCX
  TXT
}

model Rsvp {
  id         String      @id @default(cuid())
  guestId    String      @unique
  guest      Guest       @relation(fields: [guestId], references: [id], onDelete: Cascade)

  status     RsvpStatus  @default(PENDING)
  attendance Boolean?
  uniqueCode String?     @unique
  seatNumber Int?
  cardUrl    String?

  email      String?
  photoUrl   String?
  guestPhoto String?     @db.Text

  rsvpedAt   DateTime?
  updatedAt  DateTime    @updatedAt
  createdAt  DateTime    @default(now())

  @@index([uniqueCode])
  @@map("rsvps")
}

enum RsvpStatus {
  PENDING
  CONFIRMED
  DECLINED
}

model Checkin {
  id          String   @id @default(cuid())
  eventId     String
  event       Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  guestId     String   @unique
  guest       Guest    @relation(fields: [guestId], references: [id], onDelete: Cascade)

  checkedInAt DateTime @default(now())
  checkedInBy String?
  notes       String?

  @@index([eventId])
  @@map("checkins")
}

model Template {
  id           String    @id @default(cuid())
  name         String
  description  String?
  category     EventType @default(WEDDING)
  thumbnailUrl String?
  isPublic     Boolean   @default(true)
  createdBy    String?
  config       Json      @default("{}")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  events       Event[]

  @@map("templates")
}