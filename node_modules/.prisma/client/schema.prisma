generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id           String        @id @default(cuid())
  clerkId      String        @unique
  email        String        @unique
  name         String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  events       Event[]
  subscription Subscription?
  templates    Template[]
}

model Subscription {
  id        String   @id @default(cuid())
  userId    String   @unique
  plan      Plan     @default(FREE)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum Plan {
  FREE
  BASIC
  PREMIUM
}

model Event {
  id             String    @id @default(cuid())
  userId         String
  name           String
  slug           String    @unique
  eventType      EventType @default(OTHER)
  date           DateTime?
  time           String?
  venue          String?
  description    String?
  dressCode      String?
  rsvpDeadline   DateTime?
  organizerName  String?
  organizerPhone String?
  requirePhoto   Boolean   @default(false)
  isPublished    Boolean   @default(false)
  primaryColor   String    @default("#0A2810")
  secondaryColor String    @default("#B8860B")
  accentColor    String    @default("#F8F4E3")
  templateId     String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  guests         Guest[]
  checkIns       CheckIn[]
}

enum EventType {
  WEDDING
  BIRTHDAY
  CONFERENCE
  CONCERT
  CHURCH
  SEMINAR
  VIP_PARTY
  BURIAL
  PRIVATE_DINNER
  OTHER
}

model Guest {
  id          String       @id @default(cuid())
  eventId     String
  name        String
  phone       String
  email       String?
  importedVia ImportSource @default(MANUAL)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  event       Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  rsvp        RSVP?
  checkIns    CheckIn[]

  @@unique([eventId, phone])
}

enum ImportSource {
  MANUAL
  CSV
  EXCEL
  TEXT
  DOCX
}

model RSVP {
  id         String     @id @default(cuid())
  guestId    String     @unique
  status     RSVPStatus @default(PENDING)
  uniqueCode String     @unique
  seatNumber Int?
  cardUrl    String?
  photoUrl   String?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  guest      Guest      @relation(fields: [guestId], references: [id], onDelete: Cascade)
}

enum RSVPStatus {
  PENDING
  CONFIRMED
  DECLINED
}

model CheckIn {
  id        String   @id @default(cuid())
  eventId   String
  guestId   String
  createdAt DateTime @default(now())
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  guest     Guest    @relation(fields: [guestId], references: [id], onDelete: Cascade)

  @@unique([eventId, guestId])
}

model Template {
  id          String    @id @default(cuid())
  name        String
  description String?
  category    EventType @default(OTHER)
  isPublic    Boolean   @default(false)
  config      Json
  userId      String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  user        User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
}
