generator client {
  provider      = "prisma-client-js"
  // "native" = your machine / Codespace, "rhel-openssl-3.0.x" = Vercel's runtime
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  // These two names are exactly what the Vercel <-> Supabase integration creates.
  url       = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

model User {
  id           String        @id
  email        String        @unique
  name         String?
  imageUrl     String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  events       Event[]
  subscription Subscription?

  @@map("users")
}

model Subscription {
  id                    String            @id @default(cuid())
  userId                String            @unique
  user                  User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan                  String            @default("FREE")
  status                String            @default("ACTIVE")
  stripeCustomerId      String?
  stripeSubscriptionId  String?
  stripePriceId         String?
  currentPeriodStart    DateTime?
  currentPeriodEnd      DateTime?
  gifted                Boolean           @default(false)
  giftedBy              String?
  gifted                Boolean           @default(false)
  giftedBy              String?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  @@map("subscriptions")
}

model Event {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  name           String
  slug           String    @unique
  eventType      String    @default("WEDDING")
  date           DateTime
  time           String?
  venue          String
  description    String?
  dressCode      String?
  rsvpDeadline   DateTime?

  organizerName  String?
  organizerPhone String?
  organizerEmail String?

  logoUrl        String?
  coverUrl       String?
  primaryColor   String    @default("#0A2810")
  secondaryColor String    @default("#B8860B")
  accentColor    String    @default("#F8F4E3")

  templateId     String?
  template       Template? @relation(fields: [templateId], references: [id])

  isPublished    Boolean   @default(false)
  requirePhoto   Boolean   @default(true)
  maxGuests      Int?

  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  guests         Guest[]
  checkins       Checkin[]

  @@index([userId])
  @@index([slug])
  @@map("events")
}

model Guest {
  id          String       @id @default(cuid())
  eventId     String
  event       Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)

  name        String
  phone       String
  email       String?

  invited     Boolean      @default(true)
  importedAt  DateTime     @default(now())
  importedVia String       @default("MANUAL")

  rsvp        Rsvp?
  checkin     Checkin?

  @@unique([eventId, phone])
  @@index([eventId])
  @@index([phone])
  @@map("guests")
}

model Rsvp {
  id         String      @id @default(cuid())
  guestId    String      @unique
  guest      Guest       @relation(fields: [guestId], references: [id], onDelete: Cascade)

  status     String      @default("PENDING")
  attendance Boolean?
  uniqueCode String?     @unique
  seatNumber Int?
  cardUrl    String?

  email      String?
  photoUrl   String?
  guestPhoto String?

  rsvpedAt   DateTime?
  updatedAt  DateTime    @updatedAt
  createdAt  DateTime    @default(now())

  @@index([uniqueCode])
  @@map("rsvps")
}

model Checkin {
  id          String   @id @default(cuid())
  eventId     String
  event       Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  guestId     String   @unique
  guest       Guest    @relation(fields: [guestId], references: [id], onDelete: Cascade)

  checkedInAt DateTime @default(now())
  checkedInBy String?
  notes       String?

  @@index([eventId])
  @@map("checkins")
}

model Template {
  id           String    @id @default(cuid())
  name         String
  description  String?
  category     String    @default("WEDDING")
  thumbnailUrl String?
  isPublic     Boolean   @default(true)
  createdBy    String?
  config       String    @default("{}")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  events       Event[]

  @@map("templates")
}

